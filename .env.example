# Optional backend API URL. Leave empty for the local browser-only UI demo.
VITE_API_BASE_URL=http://localhost:4000

# Enables clearly labeled local demo accounts; never enable on a public production build.
VITE_DEMO_MODE=true

# OAuth client IDs are public identifiers, not secrets. Server-side token/session integration is still required.
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
